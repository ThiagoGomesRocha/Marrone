meta {
  name: setBody
  type: http
  seq: 10
}

post {
  url: {{host}}/api/echo/json
  body: json
  auth: none
}

auth:basic {
  username: asd
  password: j
}

auth:bearer {
  token: 
}

body:json {
  {
    "hello": "marrone"
  }
}

assert {
  res.status: eq 200
}

script:pre-request {
  req.setBody({
    "marrone": "is awesome"
  });
}

tests {
  test("req.setBody()", function() {
    const data = res.getBody();
    expect(data).to.eql({
      "marrone": "is awesome"
    });
  });
  
}
